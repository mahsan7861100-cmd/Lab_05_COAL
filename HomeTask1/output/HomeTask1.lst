                                ;--------------------------------------------------------------------
00000290                        ShowHex PROC
                                ;
                                ; Writes EAX in hexadecimal using EBX bytes (1, 2 or 4), adds the
                                ; suffix 'h' and pads with spaces so that the next column always
                                ; starts at the same position.
                                ; Receives: EAX = value, EBX = size of the value in bytes
                                ; Returns:  nothing (EAX, EBX and ECX are preserved)
                                ;--------------------------------------------------------------------
00000290 50                         push  eax
00000291 51                         push  ecx
00000292 E8 00000000r               call  WriteHexB                     ; 2, 4 or 8 hex digits
00000297 B068                       mov   al, 'h'
00000299 E8 00000000r               call  WriteChar
0000029E B90C000000                 mov   ecx, 12                       ; spaces = 12 - 2 * size
000002A3 2BCB                       sub   ecx, ebx
000002A5 2BCB                       sub   ecx, ebx
000002A7 B020                       mov   al, ' '
000002A9 E8 00000000r           SH1:call  WriteChar
000002AE E2F9                       loop  SH1
000002B0 59                         pop   ecx
000002B1 58                         pop   eax
000002B2 C3                         ret
000002B3                        ShowHex ENDP

                                END main


