                                ;--------------------------------------------------------------------
000002A8                        ShowSizes PROC
                                ;
                                ; Prints one row of the TYPE / LENGTHOF / SIZEOF table.
                                ; Receives: EDX = OFFSET of the row label, EAX = TYPE,
                                ;           EBX = LENGTHOF, ECX = SIZEOF
                                ; Returns:  nothing
                                ;--------------------------------------------------------------------
000002A8 60                         pushad
000002A9 E8 00000000r               call  WriteString                   ; label + declaration
000002AE 51                         push  ecx
000002AF B904000000                 mov   ecx, 4
000002B4 E81E000000                 call  WriteDecRight                 ; TYPE
000002B9 8BC3                       mov   eax, ebx
000002BB B90A000000                 mov   ecx, 10
000002C0 E812000000                 call  WriteDecRight                 ; LENGTHOF
000002C5 58                         pop   eax
000002C6 B908000000                 mov   ecx, 8
000002CB E807000000                 call  WriteDecRight                 ; SIZEOF
000002D0 E8 00000000r               call  Crlf
000002D5 61                         popad
000002D6 C3                         ret
000002D7                        ShowSizes ENDP

                                ;--------------------------------------------------------------------
000002D7                        WriteDecRight PROC
                                ;
                                ; Writes the unsigned value in EAX right-aligned in a field that is
                                ; ECX characters wide (leading spaces, then the digits).
                                ; Receives: EAX = value, ECX = field width
                                ; Returns:  nothing (all registers preserved)
                                ;--------------------------------------------------------------------
000002D7 60                         pushad
000002D8 8BF9                       mov   edi, ecx                      ; field width
000002DA 8BD8                       mov   ebx, eax                      ; keep the value
000002DC BE0A000000                 mov   esi, 10
000002E1 B900000000                 mov   ecx, 0                        ; digit counter
000002E6 BA00000000             WD1:mov   edx, 0
000002EB F7F6                       div   esi                           ; EAX = EAX / 10
000002ED 41                         inc   ecx
000002EE 83F800                     cmp   eax, 0
000002F1 75F3                       jne   WD1
000002F3 2BF9                       sub   edi, ecx                      ; spaces = width - digits
000002F5 7E0B                       jle   WD3
000002F7 8BCF                       mov   ecx, edi
000002F9 B020                       mov   al, ' '
000002FB E8 00000000r           WD2:call  WriteChar
00000300 E2F9                       loop  WD2
00000302 8BC3                   WD3:mov   eax, ebx
00000304 E8 00000000r               call  WriteDec
00000309 61                         popad
0000030A C3                         ret
0000030B                        WriteDecRight ENDP

