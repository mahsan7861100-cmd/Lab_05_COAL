                                TITLE Lab 05 - Home Task 2 : Menu String              (HomeTask2.asm)

                                ;--------------------------------------------------------------------
                                ; Name         : Muhammad Ahsan
                                ; Reg. No.     : FA24-BCS-059
                                ; Subject      : COAL
                                ; Submitted to : Sir Taimur Shahzad
                                ; Lab 05       : Stage v (verify) - Home Activities
                                ;
                                ; Home Task 2  : Create the "Checking Account" menu by declaring a
                                ;                single string, then display it with WriteString.
                                ;--------------------------------------------------------------------

                                INCLUDE Irvine32.inc
                              C ; Include file for Irvine32.lib             (Irvine32.inc)
                              C 
                              C ;OPTION CASEMAP:NONE		; optional: make identifiers case-sensitive
                              C 
                              C INCLUDE SmallWin.inc		; MS-Windows prototypes, structures, and constants
                              C .LIST
                              C INCLUDE VirtualKeys.inc
                              C ; VirtualKeys.inc
                              C .LIST
                              C 
                              C .LIST

00000000                        .data
                                ;---------- Home Task 2 : the whole menu is ONE string ----------
                                ; A comma at the end of a line continues the same BYTE declaration,
                                ; 0Dh,0Ah (CR, LF) moves to the next line and 0 ends the string.
00000000 436865636B696E6720     menu BYTE "Checking Account",0Dh,0Ah,"1) Create a new account.",0Dh,0Ah,"2) Open an existing account",0Dh,0Ah,"3) Credit the account",0Dh,0Ah,"4) Debit the account",0Dh,0Ah,"5) Exit",0Dh,0Ah,0

                                ;---------------------- strings for the output ----------------------
00000080 4C6162203035202D20     banner1 BYTE "Lab 05 - Home Task 2 : Menu declared as a string",0
000000B1 4D7568616D6D616420     banner2 BYTE "Muhammad Ahsan  |  FA24-BCS-059  |  COAL",0
000000DA 2D2D2D2D2D2D2D2D2D     dashes  BYTE "-------------------------------------------------",0
0000010C 53495A454F46206D65     sSize   BYTE "SIZEOF menu = ",0
0000011B 206279746573202863     sBytes  BYTE " bytes (characters + CR/LF pairs + null terminator)",0

00000000                        .code
00000000                        main PROC
                                    ; ---- title ----
00000000 BA 00000000o               mov   edx, OFFSET banner1
00000005 E8 00000000r               call  WriteString
0000000A E8 00000000r               call  Crlf
0000000F BA 00000000o               mov   edx, OFFSET banner2
00000014 E8 00000000r               call  WriteString
00000019 E8 00000000r               call  Crlf
0000001E BA 00000000o               mov   edx, OFFSET dashes
00000023 E8 00000000r               call  WriteString
00000028 E8 00000000r               call  Crlf
0000002D E8 00000000r               call  Crlf

                                    ; ---- display the menu (one call, one string) ----
00000032 BA 00000000o               mov   edx, OFFSET menu
00000037 E8 00000000r               call  WriteString

                                    ; ---- size of the string in memory ----
0000003C BA 00000000o               mov   edx, OFFSET dashes
00000041 E8 00000000r               call  WriteString
00000046 E8 00000000r               call  Crlf
0000004B BA 00000000o               mov   edx, OFFSET sSize
00000050 E8 00000000r               call  WriteString
00000055 B880000000                 mov   eax, SIZEOF menu
0000005A E8 00000000r               call  WriteDec
0000005F BA 00000000o               mov   edx, OFFSET sBytes
00000064 E8 00000000r               call  WriteString
00000069 E8 00000000r               call  Crlf

0000006E                            INVOKE ExitProcess,0
00000075                        main ENDP

                                END main


