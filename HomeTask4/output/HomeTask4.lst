                                ;--------------------------------------------------------------------
0000019F                        ShowHex PROC
                                ;
                                ; Writes EAX in hexadecimal using EBX bytes (1, 2 or 4), adds the
                                ; suffix 'h' and pads with spaces so that the next column always
                                ; starts at the same position.
                                ; Receives: EAX = value, EBX = size of the value in bytes
                                ; Returns:  nothing (EAX, EBX and ECX are preserved)
                                ;--------------------------------------------------------------------
0000019F 50                         push  eax
000001A0 51                         push  ecx
000001A1 E8 00000000r               call  WriteHexB                     ; 2, 4 or 8 hex digits
000001A6 B068                       mov   al, 'h'
000001A8 E8 00000000r               call  WriteChar
000001AD B90A000000                 mov   ecx, 10                       ; spaces = 10 - 2 * size
000001B2 2BCB                       sub   ecx, ebx
000001B4 2BCB                       sub   ecx, ebx
000001B6 B020                       mov   al, ' '
000001B8 E8 00000000r           SH1:call  WriteChar
000001BD E2F9                       loop  SH1
000001BF 59                         pop   ecx
000001C0 58                         pop   eax
000001C1 C3                         ret
000001C2                        ShowHex ENDP

                                ;--------------------------------------------------------------------
000001C2                        ShowChar PROC
                                ;
                                ; Writes the character in AL as  'C'  (ASCII nn)
                                ; Receives: EAX = character code (0..255)
                                ; Returns:  nothing
                                ;--------------------------------------------------------------------
000001C2 52                         push  edx
000001C3 50                         push  eax
000001C4 BA 00000000o               mov   edx, OFFSET sOpen
000001C9 E8 00000000r               call  WriteString
000001CE E8 00000000r               call  WriteChar                     ; the character itself
000001D3 BA 00000000o               mov   edx, OFFSET sAscii
000001D8 E8 00000000r               call  WriteString
000001DD E8 00000000r               call  WriteDec                      ; its ASCII code
000001E2 BA 00000000o               mov   edx, OFFSET sClose
000001E7 E8 00000000r               call  WriteString
000001EC 58                         pop   eax
000001ED 5A                         pop   edx
000001EE C3                         ret
000001EF                        ShowChar ENDP

                                END main


